# Local Docker Compose defaults. Do not use these sample values in production.
SPRING_PROFILES_ACTIVE=local

# Docker containers currently connect to the host PostgreSQL instance on port 5433.
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=update

# Optional: use the bundled pgvector database for all services in Docker.
# Uncomment all three together when using Docker Compose and the bundled postgres service.
# AUTH_DATASOURCE_URL=jdbc:postgresql://postgres:5432/postgres
# EMPLOYEE_DATASOURCE_URL=jdbc:postgresql://postgres:5432/postgres
# LEAVE_DATASOURCE_URL=jdbc:postgresql://postgres:5432/postgres

# Local development only: replace with a randomly generated secret outside local use.
JWT_SECRET=ELMS_JWT_SECRET_KEY_CHANGE_IN_PRODUCTION_MIN_32_CHARS
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=86400000

# Local origins; production should list only the deployed UI origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200,http://localhost:8080,http://localhost:8081

# Compose uses the Docker network address. A service run directly on the host uses localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP_ID=notification-group

# AI is disabled by default. Copy this file to .env to configure local secrets.
# The Gemini key pasted in a previous chat was exposed; revoke it and create a new one.
AI_ENABLED=true
AI_CHAT_PROVIDER=google-genai
AI_EMBEDDING_PROVIDER=google-genai
AI_VECTORSTORE_TYPE=pgvector
GOOGLE_API_KEY=AQ.Ab8RN6InUbrLIZd0L14Y9PgagJATKI4v09eAP1pBxU9iOmEQuA
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# SMTP credentials are placeholders until replaced with a real mail account/provider.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@elms.com
MAIL_PASSWORD=changeme
MAIL_FROM=noreply@elms.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_MANAGER_TO=manager@elms.com
MAIL_EMPLOYEE_TO=employee@elms.com